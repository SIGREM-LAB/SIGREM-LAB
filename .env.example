# Copiar a .env y rellenar. El .env NUNCA se commitea (ver .gitignore).
#
# Con Supabase local (supabase start), la CLI imprime estos valores al arrancar.
# Con un proyecto en la nube: Dashboard > Project Settings > API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La service_role key NO va aqui ni en ninguna variable VITE_*.
# Todo lo que empiece con VITE_ se empaqueta en el bundle y es publico.
# La seguridad real del sistema son las politicas de RLS, no el cliente.
