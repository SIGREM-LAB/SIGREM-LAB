# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Variables de entorno — NUNCA commitear (llaves de Supabase)
.env
.env.local
.env.*.local

# Supabase CLI
supabase/.branches
supabase/.temp
.supabase

# Python (ETL)
__pycache__/
*.py[cod]
.venv/
venv/

# Datos de origen: los Excel viven en el OneDrive del equipo, no en git
etl/datos/*
!etl/datos/README.md
# El manifiesto si va: lleva nombre, tamanio y SHA256 de los diez archivos de
# origen, y es lo unico que permite detectar que alguien actualizo un Excel
# antes de migrar. Sin el, el procedimiento de verificacion del README no se
# puede correr. No contiene datos del inventario, solo nombres y hashes.
!etl/datos/manifest.csv

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Salida del cargador: los informes de excepciones se regeneran en cada corrida
etl/review/*.csv
.pytest_cache/

# Todo lo de pruebas queda FUERA del repositorio por ahora.
#
# `etl/ejemplos/` son los archivos sinteticos en el formato unificado y el
# script que los genera. Sirven para probar la migracion, no son producto.
# Decision pendiente: si se suben, quien clone el repo puede correr el cargador
# sin pedirle nada a nadie; si no se suben, hay que regenerarlos con
# `python etl/ejemplos/generar.py` y para eso hace falta el formato unificado,
# que vive fuera del repo.
etl/ejemplos/

# Las pruebas del cargador.
etl/tests/

# Temporales de Word: los deja abiertos Office y no son parte de nada.
~$*
~WRL*.tmp
